[gd_scene format=3]

[ext_resource type="Script" path="res://ui/victory/victory_screen.gd" id="1_screen"]

[node name="VictoryScreen" type="CanvasLayer"]
layer = 10
script = ExtResource("1_screen")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.04, 0.08, 0.95)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Menu" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Plantão concluído"
horizontal_alignment = 1

[node name="Details" type="Label" parent="Center/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1

[node name="MenuButton" type="Button" parent="Center/Menu"]
unique_name_in_owner = true
layout_mode = 2
text = "Menu principal"

[connection signal="pressed" from="Center/Menu/MenuButton" to="." method="_on_menu_button_pressed"]

[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause_menu/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://ui/settings/settings_panel.tscn" id="2_settings"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_paper"]
bg_color = Color(0.86, 0.82, 0.7, 0.97)
border_width_left = 10
border_width_top = 10
border_width_right = 10
border_width_bottom = 10
border_color = Color(0.35, 0.08, 0.06, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 48.0
content_margin_top = 36.0
content_margin_right = 48.0
content_margin_bottom = 36.0

[sub_resource type="Theme" id="Theme_paper"]
Label/colors/font_color = Color(0.15, 0.1, 0.08, 1)

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 5
script = ExtResource("1_pause")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Book" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(520, 420)
layout_mode = 2
theme = SubResource("Theme_paper")
theme_override_styles/panel = SubResource("StyleBoxFlat_paper")

[node name="Pages" type="MarginContainer" parent="Center/Book"]
layout_mode = 2

[node name="IndexPage" type="VBoxContainer" parent="Center/Book/Pages"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.1, 0.08, 1)
theme_override_font_sizes/font_size = 30
text = "Pausa"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Book/Pages/IndexPage"]
unique_name_in_owner = true
layout_mode = 2
text = "Continuar"

[node name="SettingsButton" type="Button" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
text = "Configurações"

[node name="ExitButton" type="Button" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
text = "Sair para o menu"

[node name="SettingsPanel" parent="Center/Book/Pages" instance=ExtResource("2_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="ExitPage" type="VBoxContainer" parent="Center/Book/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 14

[node name="Warning" type="Label" parent="Center/Book/Pages/ExitPage"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.1, 0.08, 1)
theme_override_font_sizes/font_size = 22
text = "Sair agora perde a partida inteira: o jogo só salva entre noites."
horizontal_alignment = 1
autowrap_mode = 3

[node name="ExitConfirmButton" type="Button" parent="Center/Book/Pages/ExitPage"]
layout_mode = 2
text = "Sair e perder a partida"

[node name="ExitCancelButton" type="Button" parent="Center/Book/Pages/ExitPage"]
layout_mode = 2
text = "Voltar"

[connection signal="pressed" from="Center/Book/Pages/IndexPage/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/IndexPage/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/IndexPage/ExitButton" to="." method="_on_exit_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/ExitPage/ExitConfirmButton" to="." method="_on_exit_confirm_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/ExitPage/ExitCancelButton" to="." method="_on_exit_cancel_button_pressed"]

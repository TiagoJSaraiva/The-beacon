[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings/settings_panel.gd" id="1_panel"]

[node name="SettingsPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(420, 0)
theme_override_constants/separation = 12
script = ExtResource("1_panel")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Configurações"
horizontal_alignment = 1

[node name="MasterLabel" type="Label" parent="."]
layout_mode = 2
text = "Volume geral"

[node name="MasterSlider" type="HSlider" parent="."]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="MusicLabel" type="Label" parent="."]
layout_mode = 2
text = "Música"

[node name="MusicSlider" type="HSlider" parent="."]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="SfxLabel" type="Label" parent="."]
layout_mode = 2
text = "Efeitos sonoros"

[node name="SfxSlider" type="HSlider" parent="."]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="SensitivityLabel" type="Label" parent="."]
layout_mode = 2
text = "Sensibilidade do mouse"

[node name="SensitivitySlider" type="HSlider" parent="."]
unique_name_in_owner = true
layout_mode = 2
min_value = 0.25
max_value = 3.0
step = 0.05
value = 1.0

[node name="BackButton" type="Button" parent="."]
layout_mode = 2
text = "Voltar"

[connection signal="pressed" from="BackButton" to="." method="_on_back_button_pressed"]

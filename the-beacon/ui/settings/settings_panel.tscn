[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings/settings_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://ui/settings/controls_panel.tscn" id="2_controls"]

[node name="SettingsPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(420, 0)
theme_override_constants/separation = 12
script = ExtResource("1_panel")

[node name="General" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="General"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Configurações"
horizontal_alignment = 1

[node name="MasterLabel" type="Label" parent="General"]
layout_mode = 2
text = "Volume geral"

[node name="MasterSlider" type="HSlider" parent="General"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="MusicLabel" type="Label" parent="General"]
layout_mode = 2
text = "Música"

[node name="MusicSlider" type="HSlider" parent="General"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="SfxLabel" type="Label" parent="General"]
layout_mode = 2
text = "Efeitos sonoros"

[node name="SfxSlider" type="HSlider" parent="General"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[node name="SensitivityLabel" type="Label" parent="General"]
layout_mode = 2
text = "Sensibilidade do olhar"

[node name="SensitivitySlider" type="HSlider" parent="General"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0.25
max_value = 3.0
step = 0.05
value = 1.0

[node name="ControlsButton" type="Button" parent="General"]
unique_name_in_owner = true
layout_mode = 2
text = "Controles"

[node name="BackButton" type="Button" parent="General"]
layout_mode = 2
text = "Voltar"

[node name="ControlsPanel" parent="." instance=ExtResource("2_controls")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[connection signal="pressed" from="General/ControlsButton" to="." method="_on_controls_button_pressed"]
[connection signal="pressed" from="General/BackButton" to="." method="_on_back_button_pressed"]

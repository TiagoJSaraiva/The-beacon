[gd_scene format=3]

[ext_resource type="Script" path="res://agenda/agenda_overlay.gd" id="1_overlay"]
[ext_resource type="PackedScene" path="res://ui/settings/settings_panel.tscn" id="2_settings"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_paper"]
bg_color = Color(0.86, 0.82, 0.7, 0.97)
border_width_left = 10
border_width_top = 10
border_width_right = 10
border_width_bottom = 10
border_color = Color(0.35, 0.08, 0.06, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 48.0
content_margin_top = 36.0
content_margin_right = 48.0
content_margin_bottom = 36.0

[sub_resource type="Theme" id="Theme_paper"]
Label/colors/font_color = Color(0.15, 0.1, 0.08, 1)

[node name="AgendaOverlay" type="CanvasLayer"]
layer = 5
script = ExtResource("1_overlay")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Book" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(520, 420)
layout_mode = 2
theme = SubResource("Theme_paper")
theme_override_styles/panel = SubResource("StyleBoxFlat_paper")

[node name="Pages" type="MarginContainer" parent="Center/Book"]
layout_mode = 2

[node name="IndexPage" type="VBoxContainer" parent="Center/Book/Pages"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.1, 0.08, 1)
theme_override_font_sizes/font_size = 30
text = "Agenda do faroleiro"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.08, 0.06, 1)
text = "O tempo continua correndo."
horizontal_alignment = 1

[node name="SettingsButton" type="Button" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
text = "Configurações"

[node name="SaveButton" type="Button" parent="Center/Book/Pages/IndexPage"]
unique_name_in_owner = true
layout_mode = 2
text = "Salvar e sair"

[node name="DiscardButton" type="Button" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
text = "Sair sem salvar"

[node name="CloseButton" type="Button" parent="Center/Book/Pages/IndexPage"]
layout_mode = 2
text = "Fechar a agenda"

[node name="SettingsPanel" parent="Center/Book/Pages" instance=ExtResource("2_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="DiscardPage" type="VBoxContainer" parent="Center/Book/Pages"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 14

[node name="Warning" type="Label" parent="Center/Book/Pages/DiscardPage"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.15, 0.1, 0.08, 1)
theme_override_font_sizes/font_size = 22
text = "Sair sem salvar perde o plantão inteiro, inclusive o save anterior."
horizontal_alignment = 1
autowrap_mode = 3

[node name="DiscardConfirmButton" type="Button" parent="Center/Book/Pages/DiscardPage"]
layout_mode = 2
text = "Sair e perder tudo"

[node name="DiscardCancelButton" type="Button" parent="Center/Book/Pages/DiscardPage"]
layout_mode = 2
text = "Voltar"

[connection signal="pressed" from="Center/Book/Pages/IndexPage/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/IndexPage/SaveButton" to="." method="_on_save_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/IndexPage/DiscardButton" to="." method="_on_discard_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/IndexPage/CloseButton" to="." method="_on_close_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/DiscardPage/DiscardConfirmButton" to="." method="_on_discard_confirm_button_pressed"]
[connection signal="pressed" from="Center/Book/Pages/DiscardPage/DiscardCancelButton" to="." method="_on_discard_cancel_button_pressed"]
